---
import Layout from '../layouts/Layout.astro';
import { LanguagePage } from '../components/LanguagePage';

const faqs = [
  {
    question: "What is the best app to learn Spanish?",
    answer: "alya is a Spanish immersion feed: short real-world videos with tap-to-translate, word glosses, and native audio. instead of drilling sentences, you learn from content natives actually watch. free to download with a daily feed.",
  },
  {
    question: "How long does it take to learn Spanish?",
    answer: "Spanish is one of the easiest languages for English speakers. most learners understand everyday clips within weeks of daily scrolling (5–30 min/day). your personalized plan sets clips, words, and sessions per week.",
  },
  {
    question: "Is alya better than Duolingo for Spanish?",
    answer: "different approaches. Duolingo drills vocabulary with exercises. alya gives you real native videos with instant understanding — transcript, translation, glosses — plus a companion that grows as you learn.",
  },
  {
    question: "What kind of Spanish will I hear?",
    answer: "real-world Spanish from native videos: street interviews, vlogs, food, travel, music, culture. every clip includes translation so you always understand in context, beginner to advanced.",
  },
  {
    question: "Is alya free?",
    answer: "yes — free daily immersion feed. ALYA Plus (Annual / Monthly, 7-day free trial when eligible) unlocks Unlimited Immersion, Advanced Explanations, Unlimited Vocabulary, and Customization.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<Layout
  title="Learn Spanish by Doomscrolling | ALYA"
  description="Learn Spanish from real videos. Scroll an immersion feed, tap any word for translation, save vocabulary, grow your companion. Beginner to advanced. Free on iOS."
  canonical="/learn-spanish"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <LanguagePage
    nativeName="Español"
    languageName="Spanish"
    tagline="learn spanish by doomscrolling"
    heroSubtitle="travel, food, culture, music — learn from real videos with translation built in, not grammar tables."
    speakers="500M+"
    difficulty="accessible"
    timeToConversation="weeks"
    levels={[
      { name: "beginner", description: "short clips with full translations and glosses. tap everything — understanding is instant.", example: "¿Dónde está la estación? (Where is the station?)" },
      { name: "intermediate", description: "longer vlogs and conversations. save phrases, answer prompts, build real comprehension.", example: "Quiero aprovechar el viaje. (I want to make the most of the trip.)" },
      { name: "advanced", description: "native speed, slang, and nuance — with advanced explanations when you want them.", example: "Ojalá que puedas venir a la fiesta." },
    ]}
    faqs={faqs}
    currentPath="/learn-spanish"
    client:load
  />
</Layout>
