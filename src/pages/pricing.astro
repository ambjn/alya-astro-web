---
import Layout from '../layouts/Layout.astro';
import PricingView from '../views/Pricing';

const pricingFaqs = [
  { question: "is alya free to download?", answer: "yes, free to download on iOS. ALYA Plus membership is required to use the feed. New users get 7 days free, subject to RevenueCat eligibility, then Plus Monthly ($4.99/month) or Plus Annual ($29.99/year) renews automatically." },
  { question: "what does ALYA Plus include?", answer: "Unlimited Immersion (every clip, picked for your level), Instant Explanations (tap any phrase to understand it in context), and Your Evolving Companion (complete clips and save words to grow ALYA)." },
  { question: "how much does ALYA Plus cost?", answer: "Plus Monthly is $4.99/month. Plus Annual is $29.99/year ($2.50/month), saving 50% vs monthly. Prices in USD, billed via the App Store." },
  { question: "is there a free trial?", answer: "eligible new users get 7 days free, subject to RevenueCat eligibility. the paywall shows Start Free Trial only when your Apple ID is eligible. then the selected plan price ($4.99/month or $29.99/year) renews automatically. cancel anytime before the trial ends." },
  { question: "how do I pay, restore, or cancel?", answer: "subscriptions are processed through the App Store with RevenueCat. iOS only. already subscribed? tap Restore in the paywall. manage, upgrade, or cancel from Settings → Billing or your Apple ID subscriptions." },
  { question: "can I switch between Annual and Monthly?", answer: "yes, anytime from the paywall or settings. changes take effect at the next billing cycle." },
  { question: "what happens if I cancel?", answer: "you keep Plus until the end of the billing period. your words, stars, and companion progress stay saved. without Plus you return to the paywall, there is no free tier." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: pricingFaqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---

<Layout
  title="Pricing | ALYA Plus: $29.99/year or $4.99/month"
  description="ALYA is free to download. ALYA Plus: Annual $29.99/year ($2.50/month, save 50%) or Monthly $4.99/month, with 7 days free subject to RevenueCat eligibility. iOS only, via App Store."
  ogTitle="ALYA Pricing: Annual $29.99 / Monthly $4.99"
  ogDescription="Free to download. Plus Annual $29.99/year ($2.50/month, save 50%) or Monthly $4.99/month. 7 days free, subject to RevenueCat eligibility."
  twitterTitle="ALYA Pricing: $29.99/year or $4.99/month"
  twitterDescription="Plus Annual $29.99 ($2.50/month, save 50%) / Monthly $4.99. 7 days free, subject to RevenueCat eligibility. iOS only."
  canonical="/pricing"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <PricingView currentPath="/pricing" client:load />
</Layout>
