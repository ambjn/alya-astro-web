---
import Layout from '../layouts/Layout.astro';
import PricingView from '../views/Pricing';
import { BASE_URL, APP_STORE_URL } from '../constants';

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "ALYA Plus",
  description: "Unlimited Spanish immersion: every clip picked for your level, instant tap-to-translate explanations, unlimited vocabulary, and your evolving companion. Free to download, Plus via App Store.",
  brand: { "@type": "Brand", name: "ALYA" },
  url: `${BASE_URL}/pricing`,
  image: `${BASE_URL}/og/og.png`,
  offers: [
    { "@type": "Offer", name: "ALYA Plus Annual", price: "29.99", priceCurrency: "USD", availability: "https://schema.org/InStock", url: APP_STORE_URL, description: "Annual $29.99/year ($2.50/month, save 50% vs monthly). 7 days free for eligible new users." },
    { "@type": "Offer", name: "ALYA Plus Monthly", price: "4.99", priceCurrency: "USD", availability: "https://schema.org/InStock", url: APP_STORE_URL, description: "Monthly $4.99/month. 7 days free for eligible new users." },
  ],
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: BASE_URL },
    { "@type": "ListItem", position: 2, name: "Pricing", item: `${BASE_URL}/pricing` },
  ],
};

const pricingFaqs = [
  { question: "What is ALYA Plus?", answer: "ALYA Plus is the membership that unlocks Unlimited Immersion (every clip picked for your level), Instant Explanations (tap any phrase to understand it in context), and Your Evolving Companion. Annual $29.99/year or Monthly $4.99/month, iOS only via App Store." },
  { question: "Is there a free trial?", answer: "Eligible new users get 7 days free. The paywall shows Start Free Trial only when your Apple ID is eligible. Billing is via the App Store, iOS only." },
  { question: "Is ALYA free to download?", answer: "Yes, ALYA is free to download on iOS. ALYA Plus membership is required to use the feed after onboarding, with Annual and Monthly options." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: pricingFaqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---

<Layout
  title="Pricing | ALYA Plus: $29.99/year or $4.99/month"
  description="ALYA is free to download. Plus Annual $29.99/year ($2.50/mo, save 50%) or Monthly $4.99/mo, 7 days free if eligible. iOS only."
  ogTitle="ALYA Pricing: Annual $29.99 / Monthly $4.99"
  ogDescription="Free to download. Plus Annual $29.99/year ($2.50/month, save 50%) or Monthly $4.99/month. 7 days free for eligible new users."
  twitterTitle="ALYA Pricing: $29.99/year or $4.99/month"
  twitterDescription="Plus Annual $29.99 ($2.50/month, save 50%) / Monthly $4.99. 7 days free for eligible new users. iOS only."
  canonical="/pricing"
>
  <script type="application/ld+json" set:html={JSON.stringify([productSchema, breadcrumbSchema, faqSchema])} slot="head" />
  <PricingView currentPath="/pricing" client:load />
</Layout>
