---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found | ALYA" description="The page you're looking for doesn't exist.">
  <div class="min-h-screen bg-neutral-50 flex items-center justify-center px-6 font-sans">
    <div class="text-center max-w-sm">
      <p class="text-lime-500 text-9xl font-bold uppercase tracking-widest mb-4">404</p>
      <h1 class="text-4xl font-semibold text-neutral-900 tracking-tight mb-3">page not found</h1>
      <p class="text-neutral-400 font-light mb-8 leading-relaxed">
        the page you're looking for doesn't exist or may have moved.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 bg-neutral-900 text-white px-7 py-3 rounded-full text-sm font-semibold hover:bg-neutral-700 transition-colors"
      >
        go home
      </a>
    </div>
  </div>
</Layout>
