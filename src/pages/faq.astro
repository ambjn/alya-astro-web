---
import Layout from '../layouts/Layout.astro';
import { FAQ, faqs } from '../views/FAQ';
import { BASE_URL } from '../constants';

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer,
    },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: BASE_URL },
    { "@type": "ListItem", position: 2, name: "FAQ", item: `${BASE_URL}/faq` },
  ],
};
---

<Layout
  title="FAQ | ALYA, Spanish Immersion Feed"
  description="Everything about ALYA: What is ALYA, free download, ALYA Plus trial, tap-to-translate, companion, levels, topics. Straight answers, no fluff."
  ogTitle="alya FAQ, Frequently Asked Questions"
  ogDescription="What is ALYA? Straight answers about learning Spanish by doomscrolling, Plus trial, tap-to-translate, and companion."
  twitterTitle="ALYA FAQ: What is ALYA?"
  twitterDescription="What is ALYA? Plus trial, tap-to-translate, companion, levels. Straight answers, no fluff."
  canonical="/faq"
>
  <script type="application/ld+json" set:html={JSON.stringify([schema, breadcrumbSchema])} slot="head" />
  <FAQ currentPath="/faq" client:load />
</Layout>
