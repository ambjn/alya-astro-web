---
import Layout from '../layouts/Layout.astro';
import Topics from '../views/Topics';
import { FEED_TOPICS } from '../data/languages';
import { BASE_URL } from '../constants';

const topicNames = [...FEED_TOPICS];

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Spanish immersion topics on ALYA",
  description: "20 topics in the ALYA Spanish immersion feed, from Travel and Food to Comedy and Spanish Culture.",
  itemListElement: topicNames.map((name, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name,
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: BASE_URL },
    { "@type": "ListItem", position: 2, name: "Topics", item: `${BASE_URL}/topics` },
  ],
};
---

<Layout
  title="20 Spanish Topics: Travel, Food, Culture & More | ALYA"
  description="Pick your topics and learn Spanish from videos about them: Travel, Food, Spanish Culture, Music, Comedy, Work, Sports + 13 more. Free on iOS."
  ogTitle="20 Topics. Your Spanish Feed. | ALYA"
  ogDescription="Travel, Food, Spanish Culture, Music, Comedy + 15 more. Learn Spanish from videos you actually care about."
  twitterTitle="20 Spanish Topics: Travel, Food, Culture & More | ALYA"
  twitterDescription="Travel, Food, Culture, Music, Comedy + 15 more. Learn Spanish from videos you love. Free on iOS."
  canonical="/topics"
>
  <script type="application/ld+json" set:html={JSON.stringify([itemListSchema, breadcrumbSchema])} slot="head" />
  <Topics currentPath="/topics" client:load />
</Layout>
