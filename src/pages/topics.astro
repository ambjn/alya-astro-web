---
import Layout from '../layouts/Layout.astro';
import Topics from '../views/Topics';
import { FEED_TOPICS } from '../data/languages';

const topicNames = [...FEED_TOPICS];

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Spanish immersion topics on ALYA",
  description: "20 topics in the ALYA Spanish immersion feed, from Travel and Food to Comedy and Spanish Culture.",
  itemListElement: topicNames.map((name, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name,
  })),
};
---

<Layout
  title="20 Spanish Topics, Travel, Food, Spanish Culture, Music & More | ALYA"
  description="Pick your topics and learn Spanish from videos about them: Travel, Food, Spanish Culture, Music, Comedy, Work, Sports + 13 more. Free to download on iOS."
  ogTitle="20 Topics. Your Spanish Feed. | ALYA"
  ogDescription="Travel, Food, Spanish Culture, Music, Comedy + 15 more. Learn Spanish from videos you actually care about."
  canonical="/topics"
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} slot="head" />
  <Topics currentPath="/topics" client:load />
</Layout>
