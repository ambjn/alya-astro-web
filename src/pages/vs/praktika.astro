---
import Layout from '../../layouts/Layout.astro';
import { ComparisonPage } from '../../components/ComparisonPage';
import { BASE_URL } from '../../constants';

const faqs = [
  { question: "Is alya better than Praktika?", answer: "for real-content immersion, yes. praktika uses AI avatars for speaking drills. alya uses real native videos with tap-to-translate, plus a companion that grows with you." },
  { question: "How much does Praktika cost vs alya?", answer: "praktika's paid plans are premium-priced. alya is free to download, with Plus (Annual / Monthly, 7-day free trial when eligible) for unlimited immersion." },
  { question: "Do I need a microphone for alya?", answer: "no. just scroll, tap, listen, and save. use headphones on the bus, no speaking out loud required. prompts invite you to produce Spanish when you want to." },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: BASE_URL },
    { "@type": "ListItem", position: 2, name: "Compare", item: BASE_URL + "/features" },
    { "@type": "ListItem", position: 3, name: "ALYA vs " + "Praktika" , item: BASE_URL + "/vs/praktika" },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "alya vs Praktika, Real Videos vs AI Avatars | ALYA",
  description: "alya vs Praktika: real native Spanish videos with tap-to-translate vs AI avatar drills. Immersion that feels like scrolling. Free on iOS.",
  url: BASE_URL + "/vs/praktika",
  author: { "@type": "Organization", name: "alya", url: BASE_URL },
  publisher: {
    "@type": "Organization",
    name: "alya",
    url: BASE_URL,
    logo: { "@type": "ImageObject", url: BASE_URL + "/logo/icon.png", width: 1024, height: 1024 },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": BASE_URL + "/vs/praktika" },
};


---

<Layout
  title="alya vs Praktika, Real Videos vs AI Avatars | ALYA"
  description="alya vs Praktika: real native Spanish videos with tap-to-translate vs AI avatar drills. Immersion that feels like scrolling. Free on iOS."
  canonical="/vs/praktika"
  ogTitle="alya vs Praktika, Real Videos vs AI Avatars | ALYA"
  ogDescription="alya vs Praktika: real native Spanish videos with tap-to-translate vs AI avatar drills. Immersion that feels like scrolling. Free on iOS."
  twitterTitle="alya vs Praktika, Real Videos vs AI Avatars | ALYA"
  twitterDescription="alya vs Praktika: real native Spanish videos with tap-to-translate vs AI avatar drills. Immersion that feels like scrolling. Free on iOS."
>
  <script type="application/ld+json" set:html={JSON.stringify([articleSchema, breadcrumbSchema, faqSchema])} slot="head" />
  <ComparisonPage
    competitorName="Praktika"
    competitorTagline="AI avatar tutors"
    alyaTagline="spanish immersion feed"
    heroSubtitle="praktika gives you an avatar that drills you. alya gives you real people speaking real spanish, with help built in."
    verdict="if you want avatar drills, use praktika. if you want real spanish, scroll alya."
    rows={[
      { feature: "learning method", alya: "real video immersion", competitor: "AI avatar drills" },
      { feature: "real native content", alya: true, competitor: "synthetic avatars" },
      { feature: "tap-to-translate + glosses", alya: true, competitor: "limited" },
      { feature: "no mic needed", alya: true, competitor: "speaking-focused" },
      { feature: "companion that grows", alya: true, competitor: "avatar only" },
      { feature: "20 topics + explore", alya: true, competitor: false },
      { feature: "free tier", alya: "free download + trial", competitor: "limited" },
    ]}
    sections={[
      { heading: "avatars drill. natives immerse.", body: "praktika's avatars are consistent and patient, but they're still simulations. alya shows you how people actually talk: speed, slang, interruptions, humor, with translation so you keep up." },
      { heading: "learn anywhere, silently", body: "alya is scroll-first. no mic, no camera, no talking to your phone on the train. tap, listen with headphones, save words. produce Spanish via prompts when you're ready." },
      { heading: "the verdict", body: "avatars for drills, alya for the real thing you'll hear on the street." },
    ]}
    faqs={faqs}
    currentPath="/vs/praktika"
    client:load
  />
</Layout>
