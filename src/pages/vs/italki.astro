---
import Layout from '../../layouts/Layout.astro';
import { ComparisonPage } from '../../components/ComparisonPage';
import { BASE_URL } from '../../constants';

const faqs = [
  { question: "Is alya better than italki?", answer: "for daily input, yes. italki is the gold standard for live speaking with a human tutor ($10–50/hour, scheduled). alya builds the comprehension that makes those expensive hours actually productive." },
  { question: "Should I replace italki with alya?", answer: "no, pair them. scroll alya daily for understanding and vocabulary, book italki monthly to practice speaking. input daily, output monthly." },
  { question: "Is alya free compared to italki?", answer: "alya is free to download; Plus (Annual / Monthly, trial when eligible) is a fraction of one italki lesson. one lesson ≈ months of Plus." },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: BASE_URL },
    { "@type": "ListItem", position: 2, name: "Compare", item: BASE_URL + "/features" },
    { "@type": "ListItem", position: 3, name: "ALYA vs " + "Italki" , item: BASE_URL + "/vs/italki" },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "alya vs italki, Daily Input vs Live Tutors | ALYA",
  description: "alya vs italki: Spanish immersion feed for daily understanding vs live human tutors. Why input first makes tutors 10x more valuable. Free on iOS.",
  url: BASE_URL + "/vs/italki",
  author: { "@type": "Organization", name: "alya", url: BASE_URL },
  publisher: {
    "@type": "Organization",
    name: "alya",
    url: BASE_URL,
    logo: { "@type": "ImageObject", url: BASE_URL + "/logo/icon.png", width: 1024, height: 1024 },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": BASE_URL + "/vs/italki" },
};


---

<Layout
  title="alya vs italki, Daily Input vs Live Tutors | ALYA"
  description="alya vs italki: Spanish immersion feed for daily understanding vs live human tutors. Why input first makes tutors 10x more valuable. Free on iOS."
  canonical="/vs/italki"
  ogTitle="alya vs italki, Daily Input vs Live Tutors | ALYA"
  ogDescription="alya vs italki: Spanish immersion feed for daily understanding vs live human tutors. Why input first makes tutors 10x more valuable. Free on iOS."
  twitterTitle="alya vs italki, Daily Input vs Live Tutors | ALYA"
  twitterDescription="alya vs italki: Spanish immersion feed for daily understanding vs live human tutors. Why input first makes tutors 10x more valuable. Free on iOS."
>
  <script type="application/ld+json" set:html={JSON.stringify([articleSchema, breadcrumbSchema, faqSchema])} slot="head" />
  <ComparisonPage
    competitorName="italki"
    competitorTagline="live human tutors"
    alyaTagline="spanish immersion feed"
    heroSubtitle="italki rents you a tutor by the hour. alya gives you the language itself, every day, on demand."
    verdict="if you want a human coach, book italki. if you want to understand spanish before you pay by the hour, scroll alya."
    rows={[
      { feature: "learning method", alya: "native video immersion", competitor: "1-on-1 live lessons" },
      { feature: "available instantly", alya: true, competitor: "scheduled + paid hourly" },
      { feature: "tap-to-translate + glosses", alya: true, competitor: "ask your tutor" },
      { feature: "daily habit friendly", alya: "5–30 min/day", competitor: "$10–50/hour" },
      { feature: "beginner friendly", alya: true, competitor: "needs basics first" },
      { feature: "companion + streaks", alya: true, competitor: false },
      { feature: "free tier", alya: "free download + trial", competitor: "none (pay per lesson)" },
    ]}
    sections={[
      { heading: "tutors are precious. don't waste them on basics.", body: "an italki hour is gold, conversation, correction, cultural nuance. spending it on '¿dónde está el baño?' is expensive. alya handles the hundreds of hours of input you need first, so tutor time goes to speaking, not vocabulary lists." },
      { heading: "the ideal stack", body: "alya daily (input + words + ear training), italki monthly (output + confidence + human connection). learners who combine both progress visibly faster than either alone." },
      { heading: "the verdict", body: "book the tutor. but scroll first, you'll get 10x more from every paid hour." },
    ]}
    faqs={faqs}
    currentPath="/vs/italki"
    client:load
  />
</Layout>
