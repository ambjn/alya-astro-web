---
import Layout from '../../layouts/Layout.astro';
import { ComparisonPage } from '../../components/ComparisonPage';

const faqs = [
  { question: "Is alya better than Babbel?", answer: "for real-world understanding, yes. babbel teaches a structured curriculum with lessons. alya teaches through immersion, native videos matched to your level with instant translation." },
  { question: "Is alya cheaper than Babbel?", answer: "alya is free to download. ALYA Plus (Annual / Monthly, 7-day free trial when eligible) unlocks everything. babbel requires a paid subscription for most content." },
  { question: "Does alya have grammar like Babbel?", answer: "alya teaches grammar in context, you hear it in real videos with translations and glosses, and filter Explore by grammar (Questions, Present/Past tense, Commands, Polite phrases, Conversation). less textbook, more real usage." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } })),
};
---

<Layout
  title="alya vs Babbel, Immersion vs Curriculum | ALYA"
  description="alya vs Babbel: Spanish video immersion with tap-to-translate vs structured lessons. Real content vs curriculum. Free on iOS."
  canonical="/vs/babbel"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <ComparisonPage
    competitorName="Babbel"
    competitorTagline="structured curriculum"
    alyaTagline="spanish immersion feed"
    heroSubtitle="babbel walks you through lessons. alya drops you into real videos, with translation so you never get lost."
    verdict="if you want a syllabus, use babbel. if you want to understand natives, scroll alya."
    rows={[
      { feature: "learning method", alya: "real video immersion", competitor: "structured lessons" },
      { feature: "native videos", alya: true, competitor: false },
      { feature: "tap-to-translate + glosses", alya: true, competitor: "limited" },
      { feature: "grammar in context + filters", alya: true, competitor: "lesson-based" },
      { feature: "companion + streaks", alya: true, competitor: "partially" },
      { feature: "free tier", alya: "free download + trial", competitor: "trial only" },
      { feature: "Plus plan", alya: "Annual / Monthly", competitor: "paid plans" },
    ]}
    sections={[
      { heading: "curriculum is tidy. real life isn't.", body: "babbel's lessons are well-structured, but natives don't speak in lesson order. alya trains you on the real thing: street Spanish, vlogs, markets, music, with every line translated." },
      { heading: "grammar you hear, not memorize", body: "filter Explore by the grammar you need, then hear it used by real people. tap the words, save them, get the pattern without the table." },
      { heading: "the verdict", body: "use babbel for syllabus structure. use alya to actually understand what natives say." },
    ]}
    faqs={faqs}
    currentPath="/vs/babbel"
    client:load
  />
</Layout>
