---
import Layout from '../../layouts/Layout.astro';
import { ComparisonPage } from '../../components/ComparisonPage';
import { BASE_URL } from '../../constants';

const faqs = [
  { question: "Is alya better than Pimsleur?", answer: "for understanding real natives, yes. pimsleur trains pronunciation with listen-and-repeat audio lessons. alya trains comprehension with real videos, transcript, translation, glosses, and native audio included." },
  { question: "Can I use alya and Pimsleur together?", answer: "yes, they're complementary. pimsleur for speaking patterns and pronunciation discipline, alya for understanding fast, real-world Spanish across 20 topics." },
  { question: "Is alya free compared to Pimsleur?", answer: "alya is free to download; Plus (Annual / Monthly, trial when eligible) costs less than Pimsleur's ~$20/month subscription." },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: BASE_URL },
    { "@type": "ListItem", position: 2, name: "Compare", item: BASE_URL + "/features" },
    { "@type": "ListItem", position: 3, name: "ALYA vs " + "Pimsleur" , item: BASE_URL + "/vs/pimsleur" },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "alya vs Pimsleur, Real Videos vs Audio Lessons | ALYA",
  description: "alya vs Pimsleur: Spanish video immersion with tap-to-translate vs audio listen-and-repeat. Comprehension vs pronunciation drills. Free on iOS.",
  url: BASE_URL + "/vs/pimsleur",
  author: { "@type": "Organization", name: "alya", url: BASE_URL },
  publisher: {
    "@type": "Organization",
    name: "alya",
    url: BASE_URL,
    logo: { "@type": "ImageObject", url: BASE_URL + "/logo/icon.png", width: 1024, height: 1024 },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": BASE_URL + "/vs/pimsleur" },
};


---

<Layout
  title="alya vs Pimsleur, Real Videos vs Audio Lessons | ALYA"
  description="alya vs Pimsleur: Spanish video immersion with tap-to-translate vs audio listen-and-repeat. Comprehension vs pronunciation drills. Free on iOS."
  canonical="/vs/pimsleur"
  ogTitle="alya vs Pimsleur, Real Videos vs Audio Lessons | ALYA"
  ogDescription="alya vs Pimsleur: Spanish video immersion with tap-to-translate vs audio listen-and-repeat. Comprehension vs pronunciation drills. Free on iOS."
  twitterTitle="alya vs Pimsleur, Real Videos vs Audio Lessons | ALYA"
  twitterDescription="alya vs Pimsleur: Spanish video immersion with tap-to-translate vs audio listen-and-repeat. Comprehension vs pronunciation drills. Free on iOS."
>
  <script type="application/ld+json" set:html={JSON.stringify([articleSchema, breadcrumbSchema, faqSchema])} slot="head" />
  <ComparisonPage
    competitorName="Pimsleur"
    competitorTagline="audio listen-and-repeat"
    alyaTagline="spanish immersion feed"
    heroSubtitle="pimsleur drills your mouth with audio lessons. alya trains your ear with real videos, and lets you tap anything you miss."
    verdict="if you want pronunciation discipline, use pimsleur. if you want to understand natives, scroll alya."
    rows={[
      { feature: "learning method", alya: "real video immersion", competitor: "audio lessons" },
      { feature: "real native content", alya: true, competitor: "scripted audio" },
      { feature: "visual context", alya: true, competitor: false },
      { feature: "tap-to-translate + glosses", alya: true, competitor: false },
      { feature: "pronunciation audio", alya: "tap-to-hear + 0.75x", competitor: "core strength" },
      { feature: "20 topics + explore", alya: true, competitor: false },
      { feature: "free tier", alya: "free download + trial", competitor: "trial only" },
    ]}
    sections={[
      { heading: "speak clearly vs understand actually.", body: "pimsleur graduates pronounce beautifully, then freeze when a native replies at full speed. pronunciation without comprehension is half the skill. alya builds the other half: understanding fast, messy, real speech." },
      { heading: "ears first, mouth second", body: "watch natives with translations, slow audio to 0.75x, tap words, save them. your pronunciation improves too, from mimicking real people, not studio recordings." },
      { heading: "the verdict", body: "pimsleur for the mouth, alya for the ears. most learners need ears first." },
    ]}
    faqs={faqs}
    currentPath="/vs/pimsleur"
    client:load
  />
</Layout>
