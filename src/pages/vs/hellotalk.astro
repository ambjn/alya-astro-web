---
import Layout from '../../layouts/Layout.astro';
import { ComparisonPage } from '../../components/ComparisonPage';

const faqs = [
  { question: "Is alya better than HelloTalk?", answer: "for consistent daily input, yes. hellotalk needs a partner, scheduling, and enough Spanish to hold an exchange. alya is instant, endless native videos at your level, no pressure, no waiting." },
  { question: "Does alya replace human conversation?", answer: "alya builds the comprehension you need before human exchange works. scroll, tap, save, understand, then bring that confidence to real conversations." },
  { question: "Is HelloTalk free?", answer: "hellotalk has a free tier with limits. alya is free to download, with Plus (Annual / Monthly, trial when eligible) for unlimited immersion." },
  { question: "Can I use alya and HelloTalk together?", answer: "yes. use alya daily for input and vocabulary, hellotalk when you want live human exchange. input first, output second." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } })),
};
---

<Layout
  title="alya vs HelloTalk, Immersion vs Exchange | ALYA"
  description="alya vs HelloTalk: instant Spanish video immersion vs language exchange that needs a partner. No scheduling, just scroll. Free on iOS."
  canonical="/vs/hellotalk"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <ComparisonPage
    competitorName="HelloTalk"
    competitorTagline="human language exchange"
    alyaTagline="spanish immersion feed"
    heroSubtitle="hellotalk finds you a partner. alya gives you the language itself, hundreds of native clips, instantly understandable."
    verdict="if you want pen pals, use hellotalk. if you want daily spanish you understand, scroll alya."
    rows={[
      { feature: "learning method", alya: "native video immersion", competitor: "human exchange" },
      { feature: "available instantly", alya: true, competitor: "needs partner + scheduling" },
      { feature: "tap-to-translate + glosses", alya: true, competitor: "ask a human" },
      { feature: "beginner friendly", alya: true, competitor: "needs basics first" },
      { feature: "no social pressure", alya: true, competitor: false },
      { feature: "vocabulary + companion", alya: true, competitor: "partially" },
      { feature: "free tier", alya: "free download + trial", competitor: "limited free" },
    ]}
    sections={[
      { heading: "exchange is great, once you understand enough.", body: "hellotalk shines when you can already hold a basic conversation. before that, it's awkward: you can't understand, they can't teach. alya bridges that gap with comprehensible input." },
      { heading: "input before output", body: "watch natives, tap what you miss, save words, build comprehension daily. when you open hellotalk later, you'll actually have something to say." },
      { heading: "the verdict", body: "alya for daily understanding. hellotalk for human connection when you're ready." },
    ]}
    faqs={faqs}
    currentPath="/vs/hellotalk"
    client:load
  />
</Layout>
