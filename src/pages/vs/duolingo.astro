---
import Layout from '../../layouts/Layout.astro';
import { ComparisonPage } from '../../components/ComparisonPage';
import { comparisonSchemas } from '../../lib/comparison-schema';

const faqs = [
  { question: "Is alya better than Duolingo?", answer: "it depends on your goal. duolingo is better for gamified drills and habit streaks. alya is better for understanding real Spanish, native videos with tap-to-translate, glosses, and a companion that grows with you." },
  { question: "Does Duolingo have real videos?", answer: "no. duolingo's core is translation exercises and drills. alya is a vertical feed of real native clips, street interviews, vlogs, food, travel, each with transcript, translation, and word timing." },
  { question: "Is alya free like Duolingo?", answer: "alya is free to download. ALYA Plus membership (Annual / Monthly, 7-day free trial when eligible) unlocks Unlimited Immersion, Instant Explanations, and Your Evolving Companion." },
  { question: "Can I use alya and Duolingo together?", answer: "absolutely. many learners drill with duolingo, then build real comprehension by scrolling alya. drills for recognition, immersion for understanding." },
];

const { articleSchema, breadcrumbSchema, faqSchema } = comparisonSchemas({
  slug: "duolingo",
  competitorName: "Duolingo",
  headline: "alya vs Duolingo, Immersion vs Drills | ALYA",
  description: "alya vs Duolingo: real Spanish video feed with tap-to-translate vs gamified drills. See which builds real understanding. Try alya free on iOS.",
  faqs,
});


---

<Layout
  title="alya vs Duolingo, Immersion vs Drills | ALYA"
  description="alya vs Duolingo: real Spanish video feed with tap-to-translate vs gamified drills. See which builds real understanding. Try alya free on iOS."
  canonical="/vs/duolingo"
  ogTitle="alya vs Duolingo, Immersion vs Drills | ALYA"
  ogDescription="alya vs Duolingo: real Spanish video feed with tap-to-translate vs gamified drills. See which builds real understanding. Try alya free on iOS."
  twitterTitle="alya vs Duolingo, Immersion vs Drills | ALYA"
  twitterDescription="alya vs Duolingo: real Spanish video feed with tap-to-translate vs gamified drills. See which builds real understanding. Try alya free on iOS."
>
  <script type="application/ld+json" set:html={JSON.stringify([articleSchema, breadcrumbSchema, faqSchema])} slot="head" />
  <ComparisonPage
    competitorName="Duolingo"
    competitorTagline="gamified vocabulary drills"
    alyaTagline="spanish immersion feed"
    heroSubtitle="duolingo drills sentences written for a quiz. alya shows you real videos natives actually watch, with understanding built in."
    verdict="if you want streaks and badges, use duolingo. if you want to understand real spanish, scroll alya."
    rows={[
      { feature: "learning method", alya: "real video immersion", competitor: "gamified drills & translation" },
      { feature: "content", alya: "native clips + transcripts", competitor: "quiz sentences" },
      { feature: "tap-to-translate + glosses", alya: true, competitor: false },
      { feature: "native audio + slowdown", alya: "0.75x–1.5x", competitor: "limited" },
      { feature: "companion that grows", alya: true, competitor: false },
      { feature: "20 topics + explore filters", alya: true, competitor: false },
      { feature: "no ads on feed", alya: true, competitor: "paid only" },
      { feature: "Plus plan", alya: "Annual / Monthly", competitor: "Super / Max" },
    ]}
    sections={[
      { heading: "duolingo is great for habits. alya is great for understanding.", body: "duolingo keeps you consistent with streaks and XP. but translating 'the bear drinks milk' won't help you understand a street interview in Mexico City. alya shows you that interview, with transcript, translation, and every word tappable." },
      { heading: "immersion with training wheels", body: "every alya clip has synchronized Spanish, English meaning, per-word glosses, and native audio. slow it down, tap what you miss, save words. you're watching real content from day one, not waiting until you're 'ready'." },
      { heading: "the verdict", body: "use both if you want. duolingo for drills, alya for real comprehension. but if you only have 10 minutes, spend them understanding real spanish." },
    ]}
    faqs={faqs}
    currentPath="/vs/duolingo"
    client:load
  />
</Layout>
