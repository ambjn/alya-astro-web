---
import Layout from '../../layouts/Layout.astro';
import { ComparisonPage } from '../../components/ComparisonPage';
import { BASE_URL } from '../../constants';

const faqs = [
  { question: "Can I use ChatGPT to learn Spanish?", answer: "yes, but you have to prompt it every time, 'act as a tutor, explain this video, quiz me.' alya is ready-made: scroll the feed, tap any word, get glosses and audio instantly. no prompting." },
  { question: "Is alya better than ChatGPT for Spanish?", answer: "for daily learning, yes. alya gives you curated native videos with prepared transcripts, translations, levels, topics, vocabulary, and a companion. chatgpt is a blank chat box." },
  { question: "How much does alya cost vs ChatGPT?", answer: "alya is free to download, with Plus (Annual / Monthly, 7-day free trial when eligible) built for learners. ChatGPT Plus is $20/month for a general chatbot." },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: BASE_URL },
    { "@type": "ListItem", position: 2, name: "Compare", item: BASE_URL + "/features" },
    { "@type": "ListItem", position: 3, name: "ALYA vs " + "Chatgpt" , item: BASE_URL + "/vs/chatgpt" },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "alya vs ChatGPT for Spanish, Feed vs Chatbox | ALYA",
  description: "alya vs ChatGPT: curated Spanish immersion feed with tap-to-translate vs general chatbot that needs prompting. Free on iOS.",
  url: BASE_URL + "/vs/chatgpt",
  author: { "@type": "Organization", name: "alya", url: BASE_URL },
  publisher: {
    "@type": "Organization",
    name: "alya",
    url: BASE_URL,
    logo: { "@type": "ImageObject", url: BASE_URL + "/logo/icon.png", width: 1024, height: 1024 },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": BASE_URL + "/vs/chatgpt" },
};


---

<Layout
  title="alya vs ChatGPT for Spanish, Feed vs Chatbox | ALYA"
  description="alya vs ChatGPT: curated Spanish immersion feed with tap-to-translate vs general chatbot that needs prompting. Free on iOS."
  canonical="/vs/chatgpt"
  ogTitle="alya vs ChatGPT for Spanish, Feed vs Chatbox | ALYA"
  ogDescription="alya vs ChatGPT: curated Spanish immersion feed with tap-to-translate vs general chatbot that needs prompting. Free on iOS."
  twitterTitle="alya vs ChatGPT for Spanish, Feed vs Chatbox | ALYA"
  twitterDescription="alya vs ChatGPT: curated Spanish immersion feed with tap-to-translate vs general chatbot that needs prompting. Free on iOS."
>
  <script type="application/ld+json" set:html={JSON.stringify([articleSchema, breadcrumbSchema, faqSchema])} slot="head" />
  <ComparisonPage
    competitorName="ChatGPT"
    competitorTagline="general chatbot"
    alyaTagline="spanish immersion feed"
    heroSubtitle="chatgpt waits for the perfect prompt. alya hands you the video, the transcript, and the translation, just scroll."
    verdict="if you love prompting, use chatgpt. if you want to learn, scroll alya."
    rows={[
      { feature: "learning method", alya: "curated video feed", competitor: "blank chat prompt" },
      { feature: "native videos", alya: true, competitor: false },
      { feature: "tap-to-translate + glosses", alya: true, competitor: "manual prompting" },
      { feature: "levels + topics + filters", alya: true, competitor: false },
      { feature: "vocabulary + companion", alya: true, competitor: false },
      { feature: "works in 10 seconds", alya: true, competitor: "needs setup" },
      { feature: "Plus plan", alya: "Annual / Monthly", competitor: "$20/mo Plus" },
    ]}
    sections={[
      { heading: "chatgpt is powerful but empty.", body: "chatgpt can explain any Spanish sentence, if you paste it, prompt it right, and ask follow-ups. most learners don't. they open a blank box and close it. alya removes the blank box entirely." },
      { heading: "alya is pre-built for learning", body: "every clip arrives with transcript, translation, word timing, glosses, audio, level, and topics. tap, listen, save, earn stars. zero setup, all learning." },
      { heading: "the verdict", body: "use chatgpt for custom explanations. use alya for daily immersion you'll actually stick with." },
    ]}
    faqs={faqs}
    currentPath="/vs/chatgpt"
    client:load
  />
</Layout>
