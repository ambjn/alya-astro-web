---
import Layout from '../../layouts/Layout.astro';
import { ComparisonPage } from '../../components/ComparisonPage';

const faqs = [
  { question: "Can I use ChatGPT to learn a language?", answer: "yes, but it requires significant setup. you need to write detailed prompts telling chatgpt to act as a language tutor, correct your mistakes, and adapt to your level. alya does all of this automatically, out of the box." },
  { question: "Is alya better than ChatGPT for learning Spanish?", answer: "for learning Spanish specifically, yes. alya is purpose-built for it — automatic corrections, proficiency levels, structured conversation. chatgpt is a general tool that can be used for language learning but isn't optimized for it." },
  { question: "How much does alya cost vs ChatGPT?", answer: "alya is free with 5 messages/day. alya plus is $4.99/month. chatgpt plus is $20/month. for language learning, alya is significantly more cost-effective." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } })),
};
---

<Layout
  title="alya vs ChatGPT for Language Learning — Which Is Better? | alya"
  description="alya vs ChatGPT for language learning: purpose-built AI tutor vs general chatbot. alya adapts to your level, corrects mistakes, and teaches through conversation. free on iOS."
  canonical="/vs/chatgpt"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <ComparisonPage
    competitorName="ChatGPT"
    competitorTagline="general-purpose AI chatbot"
    alyaTagline="purpose-built language tutor"
    heroHeading="alya vs chatgpt"
    heroSubtitle="chatgpt can speak any language. alya is built to teach you one. the difference is everything."
    verdict="chatgpt is a tool. alya is a tutor. if you want to learn a language, use the one that's actually designed for it."
    rows={[
      { feature: "purpose", alya: "language learning", competitor: "general AI assistant" },
      { feature: "adapts to your proficiency level", alya: true, competitor: false },
      { feature: "automatic corrections in context", alya: true, competitor: "only if prompted" },
      { feature: "structured learning progression", alya: true, competitor: false },
      { feature: "free tier", alya: "5 msgs/day", competitor: "limited (GPT-3.5 only)" },
      { feature: "mobile app (iOS)", alya: true, competitor: true },
      { feature: "monthly price", alya: "$4.99 (plus)", competitor: "$20 (ChatGPT Plus)" },
      { feature: "built for language learners", alya: true, competitor: false },
    ]}
    sections={[
      { heading: "chatgpt can speak languages. alya teaches them.", body: "chatgpt is an incredibly powerful general AI. you can ask it to speak Spanish and it will. but it won't automatically correct your mistakes, adapt to your level, or structure the conversation to help you learn. it treats you like a peer, not a student. alya is built specifically to teach — every response is calibrated to your proficiency level and designed to move you forward." },
      { heading: "alya corrects you without you having to ask", body: "with chatgpt, you have to explicitly say 'please correct my Spanish' every time, or set up a long system prompt. alya does this automatically, naturally, in every message. when you make a grammar mistake, she corrects it in context — not with a lecture, but woven into her reply. this is how real language learning works." },
      { heading: "alya is 4x cheaper than chatgpt plus", body: "chatgpt plus costs $20/month. alya plus is $4.99/month. alya free gives you 5 messages per day with no credit card. if your goal is language learning specifically, alya gives you more value at a fraction of the price." },
      { heading: "the verdict", body: "if you need a general AI assistant, use chatgpt. if you want to learn Spanish, use alya. they're built for different things. alya's entire design — the persona, the corrections, the proficiency levels — is optimized for one thing: making you fluent in Spanish." },
    ]}
    faqs={faqs}
    currentPath="/vs/chatgpt"
    client:load
  />
</Layout>
