---
import Layout from '../layouts/Layout.astro';
import { Home } from '../views/Home';
import { BASE_URL, APP_STORE_URL } from '../constants';

const softwareAppSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Alya",
  description: "AI-powered Spanish tutor that teaches through natural conversation. Features voice input/output, spaced repetition vocabulary, grammar cards, and 8 roleplay scenarios. Works in any native language.",
  url: BASE_URL,
  applicationCategory: "EducationApplication",
  operatingSystem: "iOS, Android",
  inLanguage: "en",
  offers: [
    { "@type": "Offer", name: "Free", price: "0", priceCurrency: "USD", description: "5 conversations per day, forever free" },
    { "@type": "Offer", name: "Alya Plus", price: "6.99", priceCurrency: "USD", description: "25 conversations per day, deeper conversation memory" },
    { "@type": "Offer", name: "Alya Pro", price: "14.99", priceCurrency: "USD", description: "75 conversations per day, maximum memory, fastest model" },
  ],
  aggregateRating: { "@type": "AggregateRating", ratingValue: "4.8", ratingCount: "500" },
  author: { "@type": "Organization", name: "Alya" },
  downloadUrl: APP_STORE_URL,
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Is Alya free to use?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Alya is free to download and includes 5 conversations per day. Plus ($6.99/mo) and Pro ($14.99/mo) plans offer more daily messages and deeper conversation memory.",
      },
    },
    {
      "@type": "Question",
      name: "What language do I need to speak to use Alya?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Any language. Alya detects the language you text in, English, Hindi, French, Portuguese, Japanese, and more, and responds in that same language while teaching Spanish. You don't need to know English to use Alya.",
      },
    },
    {
      "@type": "Question",
      name: "What kind of Spanish does Alya teach?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Alya teaches Latin American Spanish, the variety spoken in Mexico, Colombia, Argentina, and across the continent. It's modern, natural, and understood everywhere. Alya deliberately avoids Spain-specific slang.",
      },
    },
    {
      "@type": "Question",
      name: "How is Alya different from Duolingo or Babbel?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Duolingo and Babbel use structured lessons, gamification, and multiple-choice exercises. Alya is a conversation, you chat with an AI that responds like a bilingual friend, teaches through context, and adapts to your level in real time. There are no levels to unlock, no hearts to lose, and no preset curriculum.",
      },
    },
    {
      "@type": "Question",
      name: "Can I practice speaking Spanish with Alya?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. You can send voice messages to Alya, which she transcribes and responds to. You can also tap any of Alya's messages to hear native-accent pronunciation of the Spanish words she's teaching.",
      },
    },
    {
      "@type": "Question",
      name: "Does Alya use AI?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Alya is powered by a large language model with real-time streaming responses. The voice features use ElevenLabs for speech-to-text and text-to-speech.",
      },
    },
  ],
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "alya",
  url: BASE_URL,
  logo: { "@type": "ImageObject", url: `${BASE_URL}/logo/icon.png`, width: 512, height: 512 },
  sameAs: ["https://twitter.com/alyacompanion", "https://instagram.com/helloalya", APP_STORE_URL],
  contactPoint: { "@type": "ContactPoint", contactType: "customer support", url: `${BASE_URL}/support` },
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "alya",
  url: BASE_URL,
  description: "Learn Spanish by chatting with an AI friend. Beginner to advanced, free on iOS.",
  potentialAction: {
    "@type": "SearchAction",
    target: { "@type": "EntryPoint", urlTemplate: `${BASE_URL}/blog?q={search_term_string}` },
    "query-input": "required name=search_term_string",
  },
};
---

<style is:global>
  html { scroll-snap-type: y mandatory; }
</style>

<Layout
  title="ALYA: Learn Spanish with AI | Chat, Speak & Get Fluent"
  description="Meet ALYA, your AI Spanish tutor. Chat like texting a friend, hear native pronunciation, save vocabulary, and actually get fluent. Free to start."
  ogTitle="ALYA: The AI Spanish Tutor That Actually Talks Back"
  ogDescription="Meet ALYA, your AI Spanish tutor. Chat like texting a friend, hear native pronunciation, save vocabulary, and actually get fluent. Free to start."
  twitterTitle="ALYA: Learn Spanish with AI | Chat, Speak & Get Fluent"
  twitterDescription="Learn Spanish by texting an AI friend. Voice, grammar, vocab & spaced repetition. Free to start."
  canonical="/"
>
  <script type="application/ld+json" set:html={JSON.stringify([softwareAppSchema, organizationSchema, websiteSchema, faqSchema])} slot="head" />
  <Home client:load />
</Layout>
