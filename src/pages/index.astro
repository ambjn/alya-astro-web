---
import Layout from '../layouts/Layout.astro';
import { Home } from '../views/home';
import { BASE_URL, APP_STORE_URL } from '../constants';

const softwareAppSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Alya",
  description: "Spanish immersion feed: scroll short real-world videos, tap any word for instant translation, save vocabulary, and grow your companion. Beginner to advanced, free on iOS.",
  url: BASE_URL,
  applicationCategory: "EducationApplication",
  operatingSystem: "iOS",
  inLanguage: "en",
  offers: [
    { "@type": "Offer", name: "Free download", price: "0", priceCurrency: "USD", description: "Free to download on iOS with 7-day free trial when eligible" },
    { "@type": "Offer", name: "Alya Plus", price: "0", priceCurrency: "USD", description: "Unlimited Immersion, Instant Explanations, Your Evolving Companion. Annual / Monthly, 7-day free trial when eligible." },
  ],
  aggregateRating: { "@type": "AggregateRating", ratingValue: "4.8", ratingCount: "500" },
  author: { "@type": "Organization", name: "Alya" },
  downloadUrl: APP_STORE_URL,
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "alya",
  url: BASE_URL,
  logo: { "@type": "ImageObject", url: `${BASE_URL}/logo/icon.png`, width: 1024, height: 1024 },
  sameAs: [APP_STORE_URL],
  contactPoint: { "@type": "ContactPoint", contactType: "customer support", url: `${BASE_URL}/support` },
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "alya",
  url: BASE_URL,
  description: "Learn Spanish by doomscrolling. Scroll real videos, tap to translate, grow your companion. Free on iOS.",
  potentialAction: {
    "@type": "SearchAction",
    target: { "@type": "EntryPoint", urlTemplate: `${BASE_URL}/blog?q={search_term_string}` },
    "query-input": "required name=search_term_string",
  },
};
---

<style is:global>
  html { scroll-snap-type: y proximity; }
</style>

<Layout
  title="ALYA: Learn Spanish by Doomscrolling | Immersion Feed"
  description="Meet ALYA, a Spanish immersion feed. Scroll real short videos, tap any word for instant translation, save vocabulary, and grow your companion. Free to start."
  ogTitle="ALYA: Learn Spanish by Doomscrolling"
  ogDescription="Scroll real Spanish videos. Tap what you don't know. Save words, earn stars, grow ALYA. Free to start."
  twitterTitle="ALYA: Learn Spanish by Doomscrolling"
  twitterDescription="Real Spanish videos with tap-to-translate, vocabulary + companion. Free to start."
  canonical="/"
>
  <script type="application/ld+json" set:html={JSON.stringify([softwareAppSchema, organizationSchema, websiteSchema])} slot="head" />
  <Home client:load />
</Layout>
