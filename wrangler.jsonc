{
	"compatibility_date": "2026-06-08",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "alya-astro-web",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "213a984c8d1045b192d4ddd394409e7b"
		}
	],
	"observability": {
		"enabled": true
	}
}